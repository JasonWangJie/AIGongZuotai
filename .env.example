# Copy to .env if configuration is needed. Never commit .env.
# Local development. Public deployment is intentionally not enabled.
APP_ADDR=127.0.0.1:8080
APP_WEB_DIR=apps/workbench/dist
# Optional CIDRs of reverse proxies which set X-Forwarded-For using the observed client IP.
# Only enable for dedicated trusted ingress; direct clients' headers are ignored by default.
# LOCALE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
PROVIDER_MODE=demo
# Optional finite server-side catalog; restart to apply. No URLs or secrets in this file.
# MODEL_CATALOG_FILE=config/models.example.json
# Private references/requests: separate tree from ASSET_DIR, APP_WEB_DIR and Vite public.
REFERENCE_DIR=.runtime/references
# Optional authenticated project MP4 export on Windows with PostgreSQL.
# Supply absolute paths to trusted tools and a separate, empty private directory.
# Tested with FFmpeg and FFprobe 9.1. Restart after configuration changes.
# VIDEO_EXPORT_FFMPEG=
# VIDEO_EXPORT_FFPROBE=
# VIDEO_EXPORT_TEMP_DIR=
# Optional authenticated order intentions. No merchant collection is enabled.
# Copy the example and set your own sale terms before enabling this for your installation.
# ORDER_CATALOG_FILE=config/order-catalog.example.json
# Single-writer admission. Includes queued and unresolved tasks across all projects.
# Generation limits: integers 1..4096; workspace streams: 1..128. Unset uses defaults below.
ADMISSION_WORKSPACE_RUNS=64
ADMISSION_MODEL_RUNS=32
ADMISSION_WORKSPACE_TASKS=128
ADMISSION_MODEL_TASKS=64
ADMISSION_WORKSPACE_STREAMS=32
# 129–16384 个全局订阅需鉴权 PostgreSQL、至少一个运行回放读连接，另占一个会话复核读连接。
ADMISSION_GLOBAL_STREAMS=128
# Chat execution is independent from accepted-resource and SSE limits.
# Single-writer workspace round-robin. Values are bounded decimal integers.
# workers/concurrency: 1..64; queue sizes: 1..4096. Restart to apply.
CHAT_WORKERS=4
# Optional for authenticated live chat with PostgreSQL. Set both values together.
# CHAT_CHILD_PROCESSES=2
# CHAT_CHILD_SLOTS=40
CHAT_QUEUE_SIZE=32
CHAT_WORKSPACE_CONCURRENCY=2
CHAT_MODEL_CONCURRENCY=4
CHAT_WORKSPACE_QUEUE_SIZE=8
# Maximum runtime after an individual chat Run starts, in seconds (1..3600).
# Unset defaults to 600. For a local 30-minute reply drill, use 2100 and restart.
# CHAT_RUN_TIMEOUT_SECONDS=600
# Extra PostgreSQL sessions for Run SSE replay only (0..4). Default 0 uses the control connection.
# RUN_REPLAY_READ_CONNECTIONS=0
# Optional PostgreSQL group commit for new unmoderated Run deltas. Default false.
# RUN_DELTA_BATCHING_ENABLED=false
# Optional PostgreSQL history capacity. Default false keeps 128 nodes per branch / 256 per conversation.
# LONG_CONVERSATION_HISTORY_ENABLED=false
# Omitted workspace defaults are min(2, workers) and min(8, queue size).
# All configured chat models share one private gateway credential/global budget.
# Media submission, phased query, private delivery and review reserve capacity.
# Native query freezes a manifest; delivery imports before durable first review.
# Unset uses 2 per lane. Submit supports 1..32. Restart to apply.
MEDIA_SUBMIT_WORKERS=2
# Original query execution supports 1..1536. Above 32 requires PostgreSQL and a separate pool.
MEDIA_QUERY_WORKERS=2
# 0 pins one PG connection per query worker. A positive pool size is at most min(32, MEDIA_QUERY_WORKERS).
MEDIA_QUERY_DB_CONNECTIONS=0
# 0 inherits the generic per-lane setting. Positive query-only ceilings are capped by query workers.
MEDIA_QUERY_WORKSPACE_CONCURRENCY=0
MEDIA_QUERY_CHANNEL_CONCURRENCY=0
# Phased media delivery includes private download, import and candidate handoff.
# Decimal 1..16, default 2. Native asynchronous media uses the separate lane.
MEDIA_DELIVERY_WORKERS=2
# Independent first-review worker ceiling: decimal 1..2, default 2.
# Output reviews and reference-input checks share the same two engine permits.
MEDIA_REVIEW_WORKERS=2
# Per workspace / frozen channel, independently in each lane; decimal 1..32.
# Effective limit never exceeds its lane workers. Restart to apply.
MEDIA_WORKSPACE_CONCURRENCY=1
MEDIA_CHANNEL_CONCURRENCY=2
# PostgreSQL + native asynchronous media requires an independent 32-byte key,
# encoded as strict standard base64. Keep outside source/logs; back it up with
# schema 020 and private files. Existing deliveries require their original key.
# MEDIA_DELIVERY_KEY=
# /metrics is disabled when unset. Use a separate 32..256-byte token, not an AI key.
# METRICS_TOKEN=
# AUTH_MODE defaults to disabled. dev:db forces required and loads the local DB file.
# AUTH_MODE=required
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/aigongzuotai_dev?sslmode=disable
# TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/aigongzuotai_test?sslmode=disable

# Explicitly set PROVIDER_MODE=live only after validating your gateway contract.
# Use the API root; the adapter appends /chat/completions.
# NEWAPI_BASE_URL=https://your-gateway.example/v1
# NEWAPI_API_KEY=
# NEWAPI_CHAT_MODEL=
# Asynchronous image/video service ROOT (different from the LLM API root above).
# Protocol: https://api.aiimg.lol/async-image-api-docs
# Requires PROVIDER_MODE=live; use your actual supported model identifiers.
# ASYNC_IMAGE_BASE_URL=https://api.aiimg.lol
# ASYNC_IMAGE_API_KEY=
# ASYNC_IMAGE_CREDENTIAL_ID=primary-media-key-v1
# ASYNC_IMAGE_MODEL=
# ASYNC_VIDEO_MODEL=
# ASYNC_VIDEO_SECONDS=5
# ASYNC_VIDEO_RESOLUTION=720p
# ASSET_DIR=.runtime/assets
# Exact public result/CDN hostnames, comma-separated; no wildcard, scheme or path.
# ASSET_ALLOWED_HOSTS=your-result-cdn.example

# Asset storage: local by default; S3 object access remains private via the Go API.
# Reference originals and immutable editing bodies stay in REFERENCE_DIR.
# ASSET_STORAGE_BACKEND=local
# S3_ENDPOINT=https://your-private-object-endpoint.example
# S3_REGION=your-region
# S3_BUCKET=your-private-bucket
# S3_PREFIX=workbench/v1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Keep all S3 credentials server-side and independent from METRICS_TOKEN.

# PostgreSQL media execution lease; decimal seconds 5..300, default 30.
# Renews every lease/3; this is not a public multi-instance deployment switch.
TASK_LEASE_SECONDS=30

# Account verification/password recovery mail. Disabled unless explicitly enabled.
# Requires PostgreSQL + AUTH_MODE=required. Never place these in VITE_* or logs.
AUTH_MAIL_ENABLED=false
# AUTH_MAIL_HOST=smtp.example.invalid
# AUTH_MAIL_PORT=465
# AUTH_MAIL_TLS_MODE=implicit_tls
# starttls is supported when the server offers verified TLS before authentication.
# AUTH_MAIL_USERNAME=
# AUTH_MAIL_PASSWORD=
# AUTH_MAIL_FROM=security@example.invalid
# AUTH_MAIL_PUBLIC_ORIGIN=https://studio.example.invalid
# Independent base64-encoded 32-byte AES key; preserve it with encrypted queue backups.
# AUTH_MAIL_OUTBOX_KEY=
# AUTH_MAIL_TIMEOUT_SECONDS=20
# AUTH_MAIL_WORKERS=1
# No plaintext SMTP, TLS-skip or console reset-link mode. Local tests use a private TLS fixture.

# V12 platform credits: default disabled; requires PostgreSQL + AUTH_MODE=required.
# Example prices are demo only. They are not currency or undocumented gateway quota.
BILLING_MODE=disabled
BILLING_PRICE_FILE=
# Local demo: config/prices.demo.example.json (PROVIDER_MODE=demo)

# V14-A scoped operations desk. No administrator is created automatically.
# Requires PostgreSQL + AUTH_MODE=required; roles are provisioned by offline CLI.
OPERATIONS_ENABLED=false

# V14-B1 text review. Requires PostgreSQL + AUTH_MODE=required; default off.
# Enabled text is delivered only after complete output review. New media requests
# require the separate media review configuration below.
MODERATION_MODE=disabled
MODERATION_POLICY_FILE=
# rules is demo-only, using config/moderation.example.json; not semantic review.
# http uses the server-side text-v1 adapter contract, not an arbitrary LLM endpoint.
# MODERATION_ENDPOINT=https://your-review-service.example/evaluate
# MODERATION_API_KEY=
# MODERATION_CREDENTIAL_ID=text-review-v1

# V14-B2 full-byte image/video review. Requires PG + required auth + text review.
# Fixtures accept only the exact repository PNG/MP4 bytes; not semantic safety.
MEDIA_MODERATION_MODE=disabled
MEDIA_MODERATION_POLICY_FILE=
# Local demo: MEDIA_MODERATION_MODE=fixtures
# MEDIA_MODERATION_POLICY_FILE=config/media-moderation.example.json
# http uses our private streaming multipart media-v1 adapter, not a New API URL.
# MEDIA_MODERATION_ENDPOINT=https://your-review-service.example/media
# MEDIA_MODERATION_API_KEY=
# MEDIA_MODERATION_CREDENTIAL_ID=media-review-v1
